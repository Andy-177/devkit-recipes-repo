{
    "material":{
        "repo":"https://github.com/amd989/Symlinker.git",
        "depth": 1
    },
    "unpack":[
        {"url":"https://dotnetcli.azureedge.net/dotnet/Sdk/10.0.403/dotnet-sdk-10.0.403-win-x64.zip","system":"win_amd64"}
    ],
    "expression":["env","run"],
    "env":[
        {"key":"Path","value":"C:\\Windows;C:\\Windows\\system32;?!{{get_workdir_path()}}\\dotnet-sdk-10.0.403-win-x64","system":"win_amd64"}
    ],
    "jobs":{
        "build-windows":{
            "system":"win_amd64",
            "steps":{
                "build":{
                    "run":[
                        ["cd workspace && cd && echo %Path% && dotnet build Symlinker/Symlinker.csproj --configuration Release"],
                        ["robocopy \"?!{{get_workdir_path()}}\\workspace\\Symlinker\\bin\\Release\\net10.0-windows\" \"?!{{get_recipe_path()}}\\net10.0-windows\" /E & exit /b 0"]
                    ]
                }
            }
        }
    }
}