{
    "clone":{
        "repo":"https://github.com/yushijinhun/authlib-injector.git",
        "depth":1
    },
    "download":[
        {"url":"https://v6.gh-proxy.org/https://github.com/git-for-windows/git/releases/download/v2.56.1.windows.1/PortableGit-2.56.1-64-bit.7z.exe","system":"win_amd64"}
    ],
    "unpack":[
        {"url":"https://v6.gh-proxy.org/https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.21+9/OpenJDK17U-jdk_x64_windows_hotspot_17.0.21_9.zip","system":"win_amd64","extract":true}
    ],
    "expression":["env","run"],
    "env":[
        {"key":"PATH","value":"C:\\Windows;C:\\Windows\\system32;C:\\Windows\\System32\\WindowsPowerShell\\v1.0;?!{{get_workdir_path()}}\\jdk-17.0.21+9\\bin;?!{{get_workdir_path()}}\\PortableGit\\cmd","system":"win_amd64"},
        {"key":"JAVA_HOME","value":"?!{{get_workdir_path()}}\\jdk-17.0.21+9","system":"win_amd64"}
    ],
    "jobs":{
        "build-windows":{
            "system":"win_amd64",
            "steps":{
                "init":{
                    "run":[
                        ["PortableGit-2.56.1-64-bit.7z.exe"],
                        ["echo 接下来会执行powershell脚本来进行镜像源替换，这步可能会触发安全软件警告，如果安全软件尝试拦截此操作请点击允许"],
                        ["echo Next, a PowerShell script will run to replace the image source. This step might trigger security software warnings, so if your security software tries to block it, please click Allow."],
                        ["echo."],
                        ["echo 如果你同意按任意键继续，不同意请关闭终端退出"],
                        ["echo Press any key to continue if you agree, or close the terminal to exit if you don't."],
                        ["pause"],
                        ["set GRADLE_PROPS_PATH=?!{{get_workdir_path()}}\\workspace\\gradle\\wrapper\\gradle-wrapper.properties && powershell -NoProfile -EncodedCommand "]
                    ]
                },
                "build":{
                    "run":[
                        ["cd workspace && echo %PATH% && echo %JAVA_HOME% && gradlew.bat"],
                        ["robocopy ?!{{get_workdir_path()}}\\workspace\\build\\libs ?!{{get_recipe_path()}} authlib-injector-snapshot.dirty.jar & exit /b 0"],
                        ["echo 构建完成，接下来将清理进程，这会执行powershell指令，请让安全软件放行此操作，如果你不想放行请立刻关闭终端，否则按任意键继续"],
                        ["echo Build complete. Next, the cleanup process will run, which will execute a PowerShell command. Please allow your security software to let this operation through. If you don't want to allow it, please close the terminal immediately, otherwise press any key to continue."],
                        ["pause"],
                        ["powershell -EncodedCommand "]
                    ]
                }
            }
        }
    }
}